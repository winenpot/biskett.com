# Copy to .env (never commit it). One file for the whole repo/machine.

# Bearer token for GET /api/submissions. Empty = the endpoint is disabled (always 401).
# Generate: openssl rand -hex 24
BISKETT_ADMIN_TOKEN=

# 1 only when a reverse proxy in front sets X-Forwarded-For (so rate limiting sees real IPs).
BISKETT_TRUST_PROXY=0

# SMTP password for biskett.config.json -> mail.smtp.user. Only needed when mail.enabled is true.
SMTP_PASSWORD=

# Published address/port (compose). Defaults: 0.0.0.0:8094. Use 127.0.0.1 to keep it private.
# BISKETT_BIND=0.0.0.0
# BISKETT_PORT=8094
